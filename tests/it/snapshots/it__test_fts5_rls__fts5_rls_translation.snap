---
source: tests/it/test_fts5_rls.rs
expression: translated_sql
---
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL CHECK (table_name <> '' AND length(table_name) <= 63), violation_type TEXT NOT NULL CHECK (violation_type IN ('select_not_visible')), row_identifier TEXT NOT NULL CHECK (row_identifier <> '' AND length(row_identifier) <= 4096), policy_name TEXT NOT NULL CHECK (policy_name IN ('SELECT policy')), detected_at TEXT NOT NULL CHECK (detected_at <> '' AND length(detected_at) <= 19), severity TEXT NOT NULL CHECK (severity IN ('error', 'warning')), detail TEXT NOT NULL CHECK (detail IN ('Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING'))) STRICT
CREATE TABLE documents_rls (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, title TEXT NOT NULL, content TEXT NOT NULL) STRICT
CREATE VIEW documents AS SELECT id, title, content FROM documents_rls
CREATE TRIGGER documents_insert_trigger INSTEAD OF INSERT ON documents FOR EACH ROW BEGIN INSERT INTO documents_rls (id, title, content) VALUES (NEW.id, NEW.title, NEW.content); END
CREATE TRIGGER documents_update_trigger INSTEAD OF UPDATE ON documents FOR EACH ROW BEGIN UPDATE documents_rls SET id = NEW.id, title = NEW.title, content = NEW.content WHERE id = OLD.id; END
CREATE TRIGGER documents_delete_trigger INSTEAD OF DELETE ON documents FOR EACH ROW BEGIN DELETE FROM documents_rls WHERE id = OLD.id; END
CREATE TRIGGER documents_rls_rls_monitor_insert AFTER INSERT ON documents_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'documents', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime(pg2sqlite_clock_timestamp()), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM documents WHERE documents.id = NEW.id)); END
CREATE TRIGGER documents_rls_rls_monitor_update AFTER UPDATE ON documents_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'documents', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime(pg2sqlite_clock_timestamp()), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM documents WHERE documents.id = NEW.id)); END
CREATE VIEW documents_rls_violations AS SELECT id, title, content FROM documents_rls WHERE NOT EXISTS (SELECT 1 FROM documents WHERE documents_rls.id = documents.id)
CREATE VIRTUAL TABLE documents_fts USING fts5 (title, content, content=documents_rls, content_rowid=id)
CREATE TRIGGER documents_fts_ai AFTER INSERT ON documents_rls BEGIN INSERT INTO documents_fts (rowid, title, content) VALUES (new.id, new.title, new.content); END
CREATE TRIGGER documents_fts_ad AFTER DELETE ON documents_rls BEGIN INSERT INTO documents_fts (documents_fts, rowid, title, content) VALUES ('delete', old.id, old.title, old.content); END
CREATE TRIGGER documents_fts_au AFTER UPDATE ON documents_rls BEGIN INSERT INTO documents_fts (documents_fts, rowid, title, content) VALUES ('delete', old.id, old.title, old.content); INSERT INTO documents_fts (rowid, title, content) VALUES (new.id, new.title, new.content); END
INSERT INTO documents_fts (rowid, title, content) SELECT id, title, content FROM documents_rls
