---
source: tests/it/test_rls_self_referential.rs
expression: translated_sql
---
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL CHECK (table_name <> '' AND length(table_name) <= 63), violation_type TEXT NOT NULL CHECK (violation_type IN ('select_not_visible')), row_identifier TEXT NOT NULL CHECK (row_identifier <> '' AND length(row_identifier) <= 4096), policy_name TEXT NOT NULL CHECK (policy_name IN ('SELECT policy')), detected_at TEXT NOT NULL CHECK (detected_at <> '' AND length(detected_at) <= 19), severity TEXT NOT NULL CHECK (severity IN ('error', 'warning')), detail TEXT NOT NULL CHECK (detail IN ('Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING'))) STRICT
CREATE TABLE app_users_rls (id BLOB PRIMARY KEY NOT NULL CHECK (length(id) = 16), email TEXT NOT NULL UNIQUE, display_name TEXT, settings TEXT) STRICT
CREATE VIEW app_users AS SELECT id, email, display_name, settings FROM app_users_rls WHERE (id = current_app_user())
CREATE TRIGGER app_users_insert_trigger INSTEAD OF INSERT ON app_users FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((NEW.id = current_app_user())) IS NOT TRUE; INSERT INTO app_users_rls (id, email, display_name, settings) VALUES (NEW.id, NEW.email, NEW.display_name, NEW.settings); END
CREATE TRIGGER app_users_rls_insert_check BEFORE INSERT ON app_users_rls FOR EACH ROW WHEN ((NEW.id = current_app_user())) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER app_users_rls_update_check BEFORE UPDATE ON app_users_rls FOR EACH ROW WHEN ((OLD.id = current_app_user())) IS NOT TRUE OR ((NEW.id = current_app_user())) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER app_users_update_trigger INSTEAD OF UPDATE ON app_users FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((OLD.id = current_app_user())) AND ((NEW.id = current_app_user())) IS NOT TRUE; UPDATE app_users_rls SET id = NEW.id, email = NEW.email, display_name = NEW.display_name, settings = NEW.settings WHERE (id = OLD.id) AND ((OLD.id = current_app_user())); END
CREATE TRIGGER app_users_delete_trigger INSTEAD OF DELETE ON app_users FOR EACH ROW BEGIN SELECT NULL; END
CREATE TRIGGER app_users_rls_rls_monitor_insert AFTER INSERT ON app_users_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'app_users', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM app_users WHERE app_users.id = NEW.id)); END
CREATE TRIGGER app_users_rls_rls_monitor_update AFTER UPDATE ON app_users_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'app_users', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM app_users WHERE app_users.id = NEW.id)); END
CREATE VIEW app_users_rls_violations AS SELECT id, email, display_name, settings FROM app_users_rls WHERE NOT EXISTS (SELECT 1 FROM app_users WHERE app_users_rls.id = app_users.id)
CREATE TABLE IF NOT EXISTS pg2sqlite_statement_refusals (id INTEGER PRIMARY KEY, database_name TEXT NOT NULL CHECK (database_name <> '' AND length(database_name) <= 4096), relation TEXT NOT NULL CHECK (relation <> '' AND length(relation) <= 63), command TEXT NOT NULL CHECK (command IN ('INSERT', 'UPDATE', 'DELETE')), column_name TEXT CHECK (column_name <> '' AND length(column_name) <= 63), message TEXT NOT NULL CHECK (message <> '' AND length(message) <= 4096)) STRICT
DELETE FROM pg2sqlite_statement_refusals
