PRAGMA foreign_keys = 1;
PRAGMA case_sensitive_like = 1;
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID;
CREATE TABLE entities (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT;
CREATE TABLE ownables (id BLOB PRIMARY KEY REFERENCES entities (id) CHECK (length(id) = 16) NOT NULL, owner TEXT NOT NULL) STRICT;
CREATE TABLE parent_relations (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, entity_id BLOB NOT NULL REFERENCES entities (id) CHECK (length(entity_id) = 16), parent_name TEXT NOT NULL) STRICT;
CREATE TABLE IF NOT EXISTS ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame INTEGER NOT NULL, side INTEGER NOT NULL, identity_0, key_0);
CREATE INDEX IF NOT EXISTS ownables_ownables_id_fkey_pg2sqlite_key_body_records_frame ON ownables_ownables_id_fkey_pg2sqlite_key_body_records(frame, side);
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_child_insert AFTER INSERT ON ownables FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 0, NEW.id, NEW.id WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (NEW.id IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 0 AND key_0 IS NOT DISTINCT FROM NEW.id AND identity_0 IS NOT DISTINCT FROM NEW.id); END;
