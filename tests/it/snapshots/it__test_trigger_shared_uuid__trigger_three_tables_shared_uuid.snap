PRAGMA foreign_keys = 1
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE entities (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT
CREATE TABLE ownables (id BLOB PRIMARY KEY REFERENCES entities (id) CHECK (length(id) = 16) NOT NULL, owner TEXT NOT NULL) STRICT
CREATE TABLE metadata (entity_id BLOB PRIMARY KEY REFERENCES entities (id) CHECK (length(entity_id) = 16) NOT NULL, created_at TEXT NOT NULL DEFAULT 'now') STRICT
CREATE TABLE entity_input (name TEXT NOT NULL) STRICT
CREATE TABLE IF NOT EXISTS metadata_metadata_entity_id_fkey_pg2sqlite_key_body_records (frame INTEGER NOT NULL, side INTEGER NOT NULL, identity_0, key_0)
CREATE INDEX IF NOT EXISTS metadata_metadata_entity_id_fkey_pg2sqlite_key_body_records_frame ON metadata_metadata_entity_id_fkey_pg2sqlite_key_body_records(frame, side)
CREATE TRIGGER metadata_metadata_entity_id_fkey_pg2sqlite_key_body_child_insert AFTER INSERT ON metadata FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO metadata_metadata_entity_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 0, NEW.entity_id, NEW.entity_id WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (NEW.entity_id IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM metadata_metadata_entity_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 0 AND key_0 IS NOT DISTINCT FROM NEW.entity_id AND identity_0 IS NOT DISTINCT FROM NEW.entity_id); END
