---
source: tests/it/test_trigger_simple.rs
expression: translated_sql
---
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE IF NOT EXISTS pg2sqlite_body_values (frame INTEGER, iteration_site INTEGER NOT NULL, iteration INTEGER NOT NULL, slot INTEGER, value, PRIMARY KEY (frame, iteration_site, iteration, slot))
CREATE TABLE orders (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, customer_name TEXT NOT NULL) STRICT
CREATE TABLE log_entries (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, order_id BLOB NOT NULL CHECK (length(order_id) = 16), message TEXT) STRICT
CREATE TRIGGER log_new_order_trigger AFTER INSERT ON orders FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7() WHERE (NOT EXISTS (SELECT 1 FROM log_entries WHERE order_id = NEW.id)); INSERT INTO log_entries (id, order_id, message) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_log_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_log_id), NEW.id, 'Order created' WHERE (NOT EXISTS (SELECT 1 FROM log_entries WHERE order_id = NEW.id)); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
