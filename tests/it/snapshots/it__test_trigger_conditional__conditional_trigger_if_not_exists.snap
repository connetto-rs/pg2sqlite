---
source: tests/it/test_trigger_conditional.rs
expression: translated_sql
---
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE IF NOT EXISTS pg2sqlite_body_values (frame INTEGER, iteration_site INTEGER NOT NULL, iteration INTEGER NOT NULL, slot INTEGER, value, PRIMARY KEY (frame, iteration_site, iteration, slot))
CREATE TABLE customer_orders (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, customer_email TEXT NOT NULL, total_amount REAL NOT NULL) STRICT
CREATE TABLE notifications (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, order_id BLOB NOT NULL CHECK (length(order_id) = 16), notification_type TEXT NOT NULL, message TEXT NOT NULL, priority INTEGER NOT NULL DEFAULT 0 CHECK (priority BETWEEN -2147483648 AND 2147483647)) STRICT
CREATE TRIGGER notify_new_order_trigger AFTER INSERT ON customer_orders FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7() WHERE (NOT EXISTS (SELECT 1 FROM notifications WHERE order_id = NEW.id AND notification_type = 'ORDER_RECEIVED')); INSERT INTO notifications (id, order_id, notification_type, message, priority) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_notif_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_notif_id), NEW.id, 'ORDER_RECEIVED', 'Order confirmation sent', 1 WHERE (NOT EXISTS (SELECT 1 FROM notifications WHERE order_id = NEW.id AND notification_type = 'ORDER_RECEIVED')); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
