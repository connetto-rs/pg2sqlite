---
source: tests/it/test_trigger_select_into.rs
expression: translated_sql
---
PRAGMA foreign_keys = 1
PRAGMA case_sensitive_like = 1
CREATE TABLE organizations (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL, level INTEGER NOT NULL DEFAULT 1 CHECK (level BETWEEN -2147483648 AND 2147483647)) STRICT
CREATE TABLE teams (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, org_id BLOB NOT NULL REFERENCES organizations (id) ON DELETE CASCADE CHECK (length(org_id) = 16), name TEXT NOT NULL) STRICT
CREATE TABLE members (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT
CREATE TABLE team_members (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, team_id BLOB NOT NULL REFERENCES teams (id) ON DELETE CASCADE CHECK (length(team_id) = 16), member_id BLOB NOT NULL REFERENCES members (id) ON DELETE CASCADE CHECK (length(member_id) = 16), UNIQUE (team_id, member_id)) STRICT
CREATE TABLE membership_audit (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, team_id BLOB NOT NULL CHECK (length(team_id) = 16), member_id BLOB NOT NULL CHECK (length(member_id) = 16), org_level INTEGER NOT NULL CHECK (org_level BETWEEN -2147483648 AND 2147483647), action TEXT NOT NULL, created_at TEXT DEFAULT (datetime('now')) CHECK (created_at IN ('infinity', '-infinity') OR (created_at GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]*' AND created_at >= '0001' AND SUBSTR(created_at, 12, 2) < '24' AND date(SUBSTR(created_at, 1, 10)) IS SUBSTR(created_at, 1, 10) AND (length(created_at) = 19 OR (length(created_at) <= 26 AND SUBSTR(created_at, 20) GLOB '.[0-9]*' AND NOT (SUBSTR(created_at, 21) GLOB '*[^0-9]*')))))) STRICT
CREATE TRIGGER after_insert_team_members AFTER INSERT ON team_members FOR EACH ROW BEGIN INSERT INTO membership_audit (id, team_id, member_id, org_level, action) WITH v_org_level (val) AS (SELECT (SELECT o.level FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)) SELECT uuidv7(), NEW.team_id, NEW.member_id, (SELECT val FROM v_org_level), 'added' WHERE (NOT EXISTS (SELECT 1 FROM membership_audit WHERE team_id = NEW.team_id AND member_id = NEW.member_id AND action = 'added')); INSERT INTO membership_audit (id, team_id, member_id, org_level, action) WITH v_org_level (val) AS (SELECT (SELECT o.level FROM organizations o JOIN teams t ON t.org_id = o.id WHERE t.id = NEW.team_id LIMIT 1)) SELECT uuidv7(), NEW.team_id, NEW.member_id, (SELECT val FROM v_org_level), 'verified' WHERE (NOT EXISTS (SELECT 1 FROM membership_audit WHERE team_id = NEW.team_id AND member_id = NEW.member_id AND action = 'verified')); END
