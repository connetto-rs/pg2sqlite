source: tests/it/test_trigger_select_into.rs
expression: translated_sql
---
PRAGMA foreign_keys = 1
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE IF NOT EXISTS pg2sqlite_body_values (frame INTEGER, iteration_site INTEGER NOT NULL, iteration INTEGER NOT NULL, slot INTEGER, value, PRIMARY KEY (frame, iteration_site, iteration, slot))
CREATE TABLE projects (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL, owner_id BLOB NOT NULL CHECK (length(owner_id) = 16), priority INTEGER NOT NULL DEFAULT 1 CHECK (priority BETWEEN -2147483648 AND 2147483647)) STRICT
CREATE TABLE tasks (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, project_id BLOB NOT NULL REFERENCES projects (id) ON DELETE CASCADE CHECK (length(project_id) = 16), title TEXT NOT NULL) STRICT
CREATE TABLE task_logs (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, task_id BLOB NOT NULL CHECK (length(task_id) = 16), project_owner_id BLOB NOT NULL CHECK (length(project_owner_id) = 16), project_priority INTEGER NOT NULL CHECK (project_priority BETWEEN -2147483648 AND 2147483647), created_at TEXT DEFAULT (datetime(substr(pg2sqlite_transaction_timestamp(), 1, 19)) || rtrim(rtrim(replace(substr(pg2sqlite_transaction_timestamp(), 20, 7), '+00:00', ''), '0'), '.')) CHECK (created_at IN ('infinity', '-infinity') OR (created_at GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]*' AND created_at >= '0001' AND SUBSTR(created_at, 12, 2) < '24' AND date(SUBSTR(created_at, 1, 10)) IS SUBSTR(created_at, 1, 10) AND (length(created_at) = 19 OR (length(created_at) <= 26 AND SUBSTR(created_at, 20) GLOB '.[0-9]*' AND NOT (SUBSTR(created_at, 21) GLOB '*[^0-9]*')))))) STRICT
CREATE TRIGGER after_insert_tasks AFTER INSERT ON tasks FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7() WHERE (NOT EXISTS (SELECT 1 FROM task_logs WHERE task_id = NEW.id)); INSERT INTO task_logs (id, task_id, project_owner_id, project_priority) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_log_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)), v_owner_id (val) AS (SELECT (SELECT p.owner_id FROM projects p WHERE p.id = NEW.project_id LIMIT 1)), v_priority (val) AS (SELECT (SELECT p.priority FROM projects p WHERE p.id = NEW.project_id LIMIT 1)) SELECT (SELECT val FROM v_log_id), NEW.id, (SELECT val FROM v_owner_id), (SELECT val FROM v_priority) WHERE (NOT EXISTS (SELECT 1 FROM task_logs WHERE task_id = NEW.id)); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
