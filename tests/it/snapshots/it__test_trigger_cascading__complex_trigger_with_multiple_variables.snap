PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE IF NOT EXISTS pg2sqlite_body_values (frame INTEGER, iteration_site INTEGER NOT NULL, iteration INTEGER NOT NULL, slot INTEGER, value, PRIMARY KEY (frame, iteration_site, iteration, slot))
CREATE TABLE products (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL, price REAL NOT NULL, initial_stock INTEGER NOT NULL DEFAULT 0 CHECK (initial_stock BETWEEN -2147483648 AND 2147483647)) STRICT
CREATE TABLE inventory (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, product_id BLOB NOT NULL UNIQUE CHECK (length(product_id) = 16), quantity INTEGER NOT NULL DEFAULT 0 CHECK (quantity BETWEEN -2147483648 AND 2147483647), last_updated TEXT DEFAULT (datetime(substr(pg2sqlite_transaction_timestamp(), 1, 19)) || rtrim(rtrim(replace(substr(pg2sqlite_transaction_timestamp(), 20, 7), '+00:00', ''), '0'), '.')) CHECK (last_updated IN ('infinity', '-infinity') OR (last_updated GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]*' AND last_updated >= '0001' AND SUBSTR(last_updated, 12, 2) < '24' AND date(SUBSTR(last_updated, 1, 10)) IS SUBSTR(last_updated, 1, 10) AND (length(last_updated) = 19 OR (length(last_updated) <= 26 AND SUBSTR(last_updated, 20) GLOB '.[0-9]*' AND NOT (SUBSTR(last_updated, 21) GLOB '*[^0-9]*')))))) STRICT
CREATE TABLE inventory_audit (id BLOB PRIMARY KEY CHECK (length(id) = 16) NOT NULL, inventory_id BLOB NOT NULL CHECK (length(inventory_id) = 16), product_id BLOB NOT NULL CHECK (length(product_id) = 16), old_quantity INTEGER CHECK (old_quantity BETWEEN -2147483648 AND 2147483647), new_quantity INTEGER NOT NULL CHECK (new_quantity BETWEEN -2147483648 AND 2147483647), change_type TEXT NOT NULL, created_at TEXT DEFAULT (datetime(substr(pg2sqlite_transaction_timestamp(), 1, 19)) || rtrim(rtrim(replace(substr(pg2sqlite_transaction_timestamp(), 20, 7), '+00:00', ''), '0'), '.')) CHECK (created_at IN ('infinity', '-infinity') OR (created_at GLOB '[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]*' AND created_at >= '0001' AND SUBSTR(created_at, 12, 2) < '24' AND date(SUBSTR(created_at, 1, 10)) IS SUBSTR(created_at, 1, 10) AND (length(created_at) = 19 OR (length(created_at) <= 26 AND SUBSTR(created_at, 20) GLOB '.[0-9]*' AND NOT (SUBSTR(created_at, 21) GLOB '*[^0-9]*')))))) STRICT
CREATE TRIGGER create_product_inventory_trigger AFTER INSERT ON products FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7() WHERE (NOT EXISTS (SELECT 1 FROM inventory WHERE product_id = NEW.id)); INSERT INTO inventory (id, product_id, quantity) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_inventory_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_inventory_id), NEW.id, NEW.initial_stock WHERE (NOT EXISTS (SELECT 1 FROM inventory WHERE product_id = NEW.id)); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
CREATE TRIGGER audit_inventory_creation_trigger AFTER INSERT ON inventory FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7() WHERE (NOT EXISTS (SELECT 1 FROM inventory_audit WHERE inventory_id = NEW.id AND change_type = 'INITIAL')); INSERT INTO inventory_audit (id, inventory_id, product_id, old_quantity, new_quantity, change_type) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_audit_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_audit_id), NEW.id, NEW.product_id, NULL, NEW.quantity, 'INITIAL' WHERE (NOT EXISTS (SELECT 1 FROM inventory_audit WHERE inventory_id = NEW.id AND change_type = 'INITIAL')); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
