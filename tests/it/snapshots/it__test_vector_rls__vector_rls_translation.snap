---
source: tests/it/test_vector_rls.rs
expression: translated_sql
---
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL CHECK (table_name <> '' AND length(table_name) <= 63), violation_type TEXT NOT NULL CHECK (violation_type IN ('select_not_visible')), row_identifier TEXT NOT NULL CHECK (row_identifier <> '' AND length(row_identifier) <= 4096), policy_name TEXT NOT NULL CHECK (policy_name IN ('SELECT policy')), detected_at TEXT NOT NULL CHECK (detected_at <> '' AND length(detected_at) <= 19), severity TEXT NOT NULL CHECK (severity IN ('error', 'warning')), detail TEXT NOT NULL CHECK (detail IN ('Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING'))) STRICT
CREATE TABLE embeddings_rls (id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, content TEXT NOT NULL, embedding BLOB) STRICT
CREATE VIEW embeddings AS SELECT id, content, embedding FROM embeddings_rls
CREATE TRIGGER embeddings_insert_trigger INSTEAD OF INSERT ON embeddings FOR EACH ROW BEGIN INSERT INTO embeddings_rls (id, content, embedding) VALUES (NEW.id, NEW.content, NEW.embedding); END
CREATE TRIGGER embeddings_update_trigger INSTEAD OF UPDATE ON embeddings FOR EACH ROW BEGIN UPDATE embeddings_rls SET id = NEW.id, content = NEW.content, embedding = NEW.embedding WHERE id = OLD.id; END
CREATE TRIGGER embeddings_delete_trigger INSTEAD OF DELETE ON embeddings FOR EACH ROW BEGIN DELETE FROM embeddings_rls WHERE id = OLD.id; END
CREATE TRIGGER embeddings_rls_rls_monitor_insert AFTER INSERT ON embeddings_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'embeddings', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime(pg2sqlite_clock_timestamp()), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM embeddings WHERE embeddings.id = NEW.id)); END
CREATE TRIGGER embeddings_rls_rls_monitor_update AFTER UPDATE ON embeddings_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'embeddings', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime(pg2sqlite_clock_timestamp()), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM embeddings WHERE embeddings.id = NEW.id)); END
CREATE VIEW embeddings_rls_violations AS SELECT id, content, embedding FROM embeddings_rls WHERE NOT EXISTS (SELECT 1 FROM embeddings WHERE embeddings_rls.id = embeddings.id)
CREATE VIRTUAL TABLE embeddings_embedding_vec USING vec0 (id_id INTEGER PRIMARY KEY, embedding float[384])
CREATE TRIGGER embeddings_embedding_vec_ai AFTER INSERT ON embeddings_rls BEGIN INSERT INTO embeddings_embedding_vec (id_id, embedding) SELECT NEW.id, NEW.embedding WHERE NEW.embedding IS NOT NULL; END
CREATE TRIGGER embeddings_embedding_vec_ad AFTER DELETE ON embeddings_rls BEGIN DELETE FROM embeddings_embedding_vec WHERE id_id = OLD.id; END
CREATE TRIGGER embeddings_embedding_vec_au AFTER UPDATE OF embedding, id ON embeddings_rls BEGIN DELETE FROM embeddings_embedding_vec WHERE id_id = OLD.id; INSERT INTO embeddings_embedding_vec (id_id, embedding) SELECT NEW.id, NEW.embedding WHERE NEW.embedding IS NOT NULL; END
