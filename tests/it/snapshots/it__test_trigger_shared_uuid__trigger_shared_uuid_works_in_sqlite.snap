PRAGMA foreign_keys = 1
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT, WITHOUT ROWID
CREATE TABLE IF NOT EXISTS pg2sqlite_body_values (frame INTEGER, iteration_site INTEGER NOT NULL, iteration INTEGER NOT NULL, slot INTEGER, value, PRIMARY KEY (frame, iteration_site, iteration, slot))
CREATE TABLE entities (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT
CREATE TABLE ownables (id BLOB PRIMARY KEY REFERENCES entities (id) CHECK (length(id) = 16) NOT NULL, owner TEXT NOT NULL) STRICT
CREATE TABLE entity_staging (name TEXT NOT NULL, owner TEXT NOT NULL) STRICT
CREATE TABLE IF NOT EXISTS ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame INTEGER NOT NULL, side INTEGER NOT NULL, identity_0, key_0)
CREATE INDEX IF NOT EXISTS ownables_ownables_id_fkey_pg2sqlite_key_body_records_frame ON ownables_ownables_id_fkey_pg2sqlite_key_body_records(frame, side)
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_child_insert AFTER INSERT ON ownables FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 0, NEW.id, NEW.id WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (NEW.id IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 0 AND key_0 IS NOT DISTINCT FROM NEW.id AND identity_0 IS NOT DISTINCT FROM NEW.id); END
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_child_update AFTER UPDATE ON ownables FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN DELETE FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE side = 0 AND identity_0 IS NOT DISTINCT FROM OLD.id AND key_0 IS NOT DISTINCT FROM OLD.id AND (OLD.id IS DISTINCT FROM NEW.id); UPDATE ownables_ownables_id_fkey_pg2sqlite_key_body_records SET identity_0 = NEW.id WHERE side = 0 AND identity_0 IS NOT DISTINCT FROM OLD.id AND key_0 IS NOT DISTINCT FROM OLD.id; INSERT INTO ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 0, NEW.id, NEW.id WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (NEW.id IS NOT NULL AND (OLD.id IS DISTINCT FROM NEW.id)) AND NOT EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 0 AND key_0 IS NOT DISTINCT FROM NEW.id AND identity_0 IS NOT DISTINCT FROM NEW.id); END
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_child_delete AFTER DELETE ON ownables FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN DELETE FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE side = 0 AND identity_0 IS NOT DISTINCT FROM OLD.id AND key_0 IS NOT DISTINCT FROM OLD.id; END
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_parent_update AFTER UPDATE ON entities FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 1, OLD.id, NULL WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (OLD.id IS NOT NULL AND (OLD.id IS DISTINCT FROM NEW.id)) AND NOT EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 1 AND key_0 IS NOT DISTINCT FROM OLD.id AND identity_0 IS NOT DISTINCT FROM NULL); END
CREATE TRIGGER ownables_ownables_id_fkey_pg2sqlite_key_body_parent_delete AFTER DELETE ON entities FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO ownables_ownables_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 1, OLD.id, NULL WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (OLD.id IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 1 AND key_0 IS NOT DISTINCT FROM OLD.id AND identity_0 IS NOT DISTINCT FROM NULL); END
CREATE TRIGGER trigger_create_entity_ownable AFTER INSERT ON entity_staging FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_invocation'; INSERT INTO pg2sqlite_body_values (frame, iteration_site, iteration, slot, value) SELECT (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')), 0, 0, 0, uuidv7(); INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_statement'; INSERT INTO entities (id, name) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_new_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_new_id), NEW.name; SELECT RAISE(ABORT, '23503: update or delete on table "entities" violates foreign key constraint "ownables_id_fkey" on table "ownables"') WHERE EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records AS captured WHERE captured.frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND captured.side = 1 AND NOT EXISTS (SELECT 1 FROM entities AS parent WHERE parent.id = captured.key_0) AND EXISTS (SELECT 1 FROM ownables AS child WHERE child.id = captured.key_0)); SELECT RAISE(ABORT, '23503: insert or update on table "ownables" violates foreign key constraint "ownables_id_fkey"') WHERE EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records AS captured WHERE captured.frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND captured.side = 0 AND NOT EXISTS (SELECT 1 FROM entities AS parent WHERE parent.id = captured.key_0) AND EXISTS (SELECT 1 FROM ownables AS child WHERE child.id IS NOT DISTINCT FROM captured.identity_0 AND child.id = captured.key_0)); DELETE FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped')); INSERT INTO pg2sqlite_definer_frames (id, owner) SELECT (SELECT coalesce(max(id), 0) + 1 FROM pg2sqlite_definer_frames), 'pg_body_statement'; INSERT INTO ownables (id, owner) WITH pg2sqlite_stored_0 (val) AS (SELECT (SELECT value FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')) AND iteration_site = 0 AND iteration = 0 AND slot = 0)), v_new_id (val) AS (SELECT (SELECT val FROM pg2sqlite_stored_0)) SELECT (SELECT val FROM v_new_id), NEW.owner; SELECT RAISE(ABORT, '23503: update or delete on table "entities" violates foreign key constraint "ownables_id_fkey" on table "ownables"') WHERE EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records AS captured WHERE captured.frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND captured.side = 1 AND NOT EXISTS (SELECT 1 FROM entities AS parent WHERE parent.id = captured.key_0) AND EXISTS (SELECT 1 FROM ownables AS child WHERE child.id = captured.key_0)); SELECT RAISE(ABORT, '23503: insert or update on table "ownables" violates foreign key constraint "ownables_id_fkey"') WHERE EXISTS (SELECT 1 FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records AS captured WHERE captured.frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND captured.side = 0 AND NOT EXISTS (SELECT 1 FROM entities AS parent WHERE parent.id = captured.key_0) AND EXISTS (SELECT 1 FROM ownables AS child WHERE child.id IS NOT DISTINCT FROM captured.identity_0 AND child.id = captured.key_0)); DELETE FROM ownables_ownables_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped')); DELETE FROM pg2sqlite_body_values WHERE frame = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_invocation', 'pg_body_invocation_cancelled')); END
