CREATE VIEW grants_rls_violations AS SELECT id, ownable_id, grantee_id, grantor_id, role_id FROM grants_rls WHERE NOT EXISTS (SELECT 1 FROM grants WHERE grants_rls.id = grants.id)
CREATE VIEW grants_unfiltered AS SELECT id AS id, ownable_id AS ownable_id, grantee_id AS grantee_id, grantor_id AS grantor_id, role_id AS role_id FROM grants_rls
CREATE VIEW ownables AS SELECT id, title, created_by FROM ownables_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = ownables_rls.id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = ownables_rls.id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_unfiltered g WHERE g.ownable_id = ownables_rls.id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownables_insert_trigger INSTEAD OF INSERT ON ownables FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((NEW.created_by = current_app_user())) IS NOT TRUE; INSERT INTO ownables_rls (id, title, created_by) VALUES (COALESCE(NEW.id, uuidv7()), NEW.title, NEW.created_by); END
