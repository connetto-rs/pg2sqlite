CREATE TRIGGER grants_update_trigger INSTEAD OF UPDATE ON grants FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((OLD.grantor_id = current_app_user())) AND (((NEW.grantor_id = current_app_user())) IS NOT TRUE OR ((NEW.grantor_id = current_app_user() OR NEW.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = NEW.grantee_id) OR EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = NEW.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))))) IS NOT TRUE); UPDATE grants_rls SET id = NEW.id, ownable_id = NEW.ownable_id, grantee_id = NEW.grantee_id, grantor_id = NEW.grantor_id, role_id = NEW.role_id WHERE (id = OLD.id) AND ((OLD.grantor_id = current_app_user())); END
CREATE TRIGGER grants_delete_trigger INSTEAD OF DELETE ON grants FOR EACH ROW BEGIN DELETE FROM grants_rls WHERE (id = OLD.id) AND ((OLD.grantor_id = current_app_user() OR EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = OLD.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))); END
CREATE TRIGGER grants_rls_rls_monitor_insert AFTER INSERT ON grants_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'grants', 'select_not_visible', substr('id=' || quote(NEW.id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM grants WHERE grants.id = NEW.id)); END
