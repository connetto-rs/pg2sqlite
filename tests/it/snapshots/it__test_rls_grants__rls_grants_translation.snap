DROP TRIGGER IF EXISTS groups_insert_trigger
DROP TRIGGER IF EXISTS users_insert_trigger
DROP TRIGGER IF EXISTS group_membership_insert_trigger
DROP TRIGGER IF EXISTS group_membership_delete_trigger
CREATE TABLE ownable_owners_rls (ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) CHECK (length(ownable_id) = 16), owner_id BLOB NOT NULL REFERENCES owners (id) CHECK (length(owner_id) = 16), PRIMARY KEY (ownable_id, owner_id)) STRICT
CREATE VIEW ownable_owners AS SELECT ownable_id, owner_id FROM ownable_owners_rls
CREATE TRIGGER ownable_owners_insert_trigger INSTEAD OF INSERT ON ownable_owners FOR EACH ROW BEGIN INSERT INTO ownable_owners_rls (ownable_id, owner_id) VALUES (NEW.ownable_id, NEW.owner_id); END
CREATE TRIGGER ownable_owners_update_trigger INSTEAD OF UPDATE ON ownable_owners FOR EACH ROW BEGIN UPDATE ownable_owners_rls SET ownable_id = NEW.ownable_id, owner_id = NEW.owner_id WHERE ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id; END
CREATE TRIGGER ownable_owners_delete_trigger INSTEAD OF DELETE ON ownable_owners FOR EACH ROW BEGIN DELETE FROM ownable_owners_rls WHERE ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id; END
CREATE TRIGGER ownable_owners_rls_update_check BEFORE UPDATE ON ownable_owners_rls FOR EACH ROW WHEN NOT EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner NOT IN ('pg_body_statement', 'pg_body_statement_skipped')) AND owner IN ('pg_key_action', 'pg_truncate')) BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
