CREATE TRIGGER ownable_administrators_ownable_administrators_administrator_id_fkey_pg2sqlite_key_delete AFTER DELETE ON owners FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (owner) VALUES ('pg_key_action'); DELETE FROM ownable_administrators_rls WHERE administrator_id = OLD.id; DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames); END
CREATE TRIGGER ownable_administrators_ownable_administrators_granted_by_fkey_pg2sqlite_key_delete AFTER DELETE ON users FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (owner) VALUES ('pg_key_action'); DELETE FROM ownable_administrators_rls WHERE granted_by = OLD.id; DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames); END
CREATE TABLE grants_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) CHECK (length(ownable_id) = 16), grantee_id BLOB NOT NULL REFERENCES owners (id) CHECK (length(grantee_id) = 16), grantor_id BLOB NOT NULL REFERENCES owners (id) ON DELETE RESTRICT CHECK (length(grantor_id) = 16), role_id INTEGER NOT NULL REFERENCES roles (id) CHECK (role_id BETWEEN -32768 AND 32767), UNIQUE (ownable_id, grantee_id)) STRICT
