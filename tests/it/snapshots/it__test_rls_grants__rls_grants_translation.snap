CREATE VIEW ownables_rls_violations AS SELECT id, title, created_by FROM ownables_rls WHERE NOT EXISTS (SELECT 1 FROM ownables WHERE ownables_rls.id = ownables.id)
DROP VIEW ownable_owners
CREATE VIEW ownable_owners AS SELECT ownable_id, owner_id FROM ownable_owners_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = ownable_owners_rls.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = ownable_owners_rls.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))) OR EXISTS (SELECT 1 FROM grants_unfiltered g WHERE g.ownable_id = ownable_owners_rls.ownable_id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownable_owners_insert_trigger INSTEAD OF INSERT ON ownable_owners FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = NEW.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))) OR (NEW.owner_id = current_app_user() AND NOT EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = NEW.ownable_id) AND EXISTS (SELECT 1 FROM ownables_unfiltered o WHERE o.id = NEW.ownable_id AND o.created_by = current_app_user())))) IS NOT TRUE; INSERT INTO ownable_owners_rls (ownable_id, owner_id) VALUES (NEW.ownable_id, NEW.owner_id); END
CREATE TRIGGER ownable_owners_rls_insert_check BEFORE INSERT ON ownable_owners_rls FOR EACH ROW WHEN ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = NEW.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))) OR (NEW.owner_id = current_app_user() AND NOT EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = NEW.ownable_id) AND EXISTS (SELECT 1 FROM ownables_unfiltered o WHERE o.id = NEW.ownable_id AND o.created_by = current_app_user())))) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER ownable_owners_update_trigger INSTEAD OF UPDATE ON ownable_owners FOR EACH ROW BEGIN SELECT NULL; END
CREATE TRIGGER ownable_owners_delete_trigger INSTEAD OF DELETE ON ownable_owners FOR EACH ROW BEGIN DELETE FROM ownable_owners_rls WHERE (ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id) AND ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo2 WHERE oo2.ownable_id = OLD.ownable_id AND (oo2.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo2.owner_id))))); END
CREATE TRIGGER ownable_owners_rls_rls_monitor_insert AFTER INSERT ON ownable_owners_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'ownable_owners', 'select_not_visible', substr('ownable_id=' || quote(NEW.ownable_id) || ', ' || 'owner_id=' || quote(NEW.owner_id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM ownable_owners WHERE ownable_owners.ownable_id = NEW.ownable_id AND ownable_owners.owner_id = NEW.owner_id)); END
CREATE TRIGGER ownable_owners_rls_rls_monitor_update AFTER UPDATE ON ownable_owners_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'ownable_owners', 'select_not_visible', substr('ownable_id=' || quote(NEW.ownable_id) || ', ' || 'owner_id=' || quote(NEW.owner_id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM ownable_owners WHERE ownable_owners.ownable_id = NEW.ownable_id AND ownable_owners.owner_id = NEW.owner_id)); END
CREATE VIEW ownable_owners_rls_violations AS SELECT ownable_id, owner_id FROM ownable_owners_rls WHERE NOT EXISTS (SELECT 1 FROM ownable_owners WHERE ownable_owners_rls.ownable_id = ownable_owners.ownable_id AND ownable_owners_rls.owner_id = ownable_owners.owner_id)
CREATE VIEW ownable_administrators AS SELECT ownable_id, administrator_id, granted_by FROM ownable_administrators_rls WHERE (EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = ownable_administrators_rls.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa2 WHERE oa2.ownable_id = ownable_administrators_rls.ownable_id AND (oa2.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa2.administrator_id))) OR EXISTS (SELECT 1 FROM grants_unfiltered g WHERE g.ownable_id = ownable_administrators_rls.ownable_id AND g.role_id >= 2 AND (g.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = g.grantee_id))))
CREATE TRIGGER ownable_administrators_insert_trigger INSTEAD OF INSERT ON ownable_administrators FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))) IS NOT TRUE; INSERT INTO ownable_administrators_rls (ownable_id, administrator_id, granted_by) VALUES (NEW.ownable_id, NEW.administrator_id, NEW.granted_by); END
CREATE TRIGGER ownable_administrators_rls_insert_check BEFORE INSERT ON ownable_administrators_rls FOR EACH ROW WHEN ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER ownable_administrators_update_trigger INSTEAD OF UPDATE ON ownable_administrators FOR EACH ROW BEGIN SELECT NULL; END
CREATE TRIGGER ownable_administrators_delete_trigger INSTEAD OF DELETE ON ownable_administrators FOR EACH ROW BEGIN DELETE FROM ownable_administrators_rls WHERE (ownable_id = OLD.ownable_id AND administrator_id = OLD.administrator_id) AND ((EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = OLD.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))))); END
CREATE TRIGGER ownable_administrators_rls_rls_monitor_insert AFTER INSERT ON ownable_administrators_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'ownable_administrators', 'select_not_visible', substr('ownable_id=' || quote(NEW.ownable_id) || ', ' || 'administrator_id=' || quote(NEW.administrator_id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM ownable_administrators WHERE ownable_administrators.ownable_id = NEW.ownable_id AND ownable_administrators.administrator_id = NEW.administrator_id)); END
CREATE TRIGGER ownable_administrators_rls_rls_monitor_update AFTER UPDATE ON ownable_administrators_rls FOR EACH ROW BEGIN INSERT INTO rls_audit (table_name, violation_type, row_identifier, policy_name, detected_at, severity, detail) SELECT 'ownable_administrators', 'select_not_visible', substr('ownable_id=' || quote(NEW.ownable_id) || ', ' || 'administrator_id=' || quote(NEW.administrator_id), 1, 4096), 'SELECT policy', datetime('now'), 'warning', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING' WHERE NOT (EXISTS (SELECT 1 FROM ownable_administrators WHERE ownable_administrators.ownable_id = NEW.ownable_id AND ownable_administrators.administrator_id = NEW.administrator_id)); END
CREATE VIEW ownable_administrators_rls_violations AS SELECT ownable_id, administrator_id, granted_by FROM ownable_administrators_rls WHERE NOT EXISTS (SELECT 1 FROM ownable_administrators WHERE ownable_administrators_rls.ownable_id = ownable_administrators.ownable_id AND ownable_administrators_rls.administrator_id = ownable_administrators.administrator_id)
