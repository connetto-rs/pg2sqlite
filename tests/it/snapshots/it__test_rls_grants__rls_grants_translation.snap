PRAGMA foreign_keys = 1
PRAGMA case_sensitive_like = 1
CREATE TABLE IF NOT EXISTS rls_audit (id INTEGER PRIMARY KEY AUTOINCREMENT, table_name TEXT NOT NULL CHECK (table_name <> '' AND length(table_name) <= 63), violation_type TEXT NOT NULL CHECK (violation_type IN ('select_not_visible')), row_identifier TEXT NOT NULL CHECK (row_identifier <> '' AND length(row_identifier) <= 4096), policy_name TEXT NOT NULL CHECK (policy_name IN ('SELECT policy')), detected_at TEXT NOT NULL CHECK (detected_at <> '' AND length(detected_at) <= 19), severity TEXT NOT NULL CHECK (severity IN ('error', 'warning')), detail TEXT NOT NULL CHECK (detail IN ('Row inserted into backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING', 'Row updated in backing table but not readable through the RLS view; PostgreSQL allows this for writes without RETURNING'))) STRICT
CREATE TABLE IF NOT EXISTS pg2sqlite_definer_frames (id INTEGER PRIMARY KEY, owner TEXT NOT NULL CHECK (owner <> '' AND length(owner) <= 63)) STRICT
CREATE TABLE owners (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL) STRICT
CREATE TABLE groups (id BLOB PRIMARY KEY REFERENCES owners (id) ON DELETE CASCADE CHECK (length(id) = 16) NOT NULL, parent_group_id BLOB REFERENCES groups (id) ON DELETE CASCADE CHECK (length(parent_group_id) = 16), name TEXT NOT NULL) STRICT
CREATE TRIGGER groups_insert_trigger BEFORE INSERT ON groups FOR EACH ROW BEGIN INSERT INTO owners (id) VALUES (NEW.id); END
CREATE TABLE users (id BLOB PRIMARY KEY REFERENCES owners (id) ON DELETE CASCADE CHECK (length(id) = 16) NOT NULL, name TEXT NOT NULL) STRICT
CREATE TRIGGER users_insert_trigger BEFORE INSERT ON users FOR EACH ROW BEGIN INSERT INTO owners (id) VALUES (NEW.id); END
CREATE TABLE group_memberships (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, group_id BLOB NOT NULL REFERENCES groups (id) ON DELETE CASCADE CHECK (length(group_id) = 16), user_id BLOB NOT NULL REFERENCES users (id) ON DELETE CASCADE CHECK (length(user_id) = 16), UNIQUE (group_id, user_id)) STRICT
CREATE TRIGGER group_membership_insert_trigger AFTER INSERT ON group_memberships FOR EACH ROW BEGIN INSERT OR IGNORE INTO group_memberships (group_id, user_id) SELECT recursive_cte_subquery.id, recursive_cte_subquery.user_id FROM (WITH RECURSIVE parent_groups (id) AS (SELECT parent_group_id AS id FROM groups WHERE id = NEW.group_id UNION ALL SELECT g.parent_group_id FROM groups g JOIN parent_groups pg ON g.id = pg.id) SELECT id, NEW.user_id FROM parent_groups WHERE id IS NOT NULL) recursive_cte_subquery; END
CREATE TRIGGER group_membership_delete_trigger AFTER DELETE ON group_memberships FOR EACH ROW BEGIN DELETE FROM group_memberships WHERE user_id = OLD.user_id AND group_id IN (WITH RECURSIVE child_groups (id) AS (SELECT id FROM groups WHERE parent_group_id = OLD.group_id UNION ALL SELECT g.id FROM groups g JOIN child_groups cg ON g.parent_group_id = cg.id) SELECT id FROM child_groups); END
CREATE TABLE roles (id INTEGER PRIMARY KEY CHECK (id BETWEEN -32768 AND 32767) NOT NULL, name TEXT NOT NULL UNIQUE) STRICT
INSERT INTO roles (id, name) VALUES (2, 'viewer'), (3, 'editor')
CREATE TABLE ownables_rls (id BLOB PRIMARY KEY DEFAULT (uuidv7()) CHECK (length(id) = 16) NOT NULL, title TEXT NOT NULL, created_by BLOB NOT NULL REFERENCES owners (id) ON DELETE RESTRICT CHECK (length(created_by) = 16)) STRICT
CREATE TRIGGER ownables_rls_insert_check BEFORE INSERT ON ownables_rls FOR EACH ROW WHEN ((NEW.created_by = current_app_user())) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TABLE ownable_owners_rls (ownable_id BLOB NOT NULL REFERENCES ownables_rls (id) CHECK (length(ownable_id) = 16), owner_id BLOB NOT NULL REFERENCES owners (id) CHECK (length(owner_id) = 16), PRIMARY KEY (ownable_id, owner_id)) STRICT
CREATE VIEW ownable_owners AS SELECT ownable_id, owner_id FROM ownable_owners_rls
CREATE TRIGGER ownable_owners_insert_trigger INSTEAD OF INSERT ON ownable_owners FOR EACH ROW BEGIN INSERT INTO ownable_owners_rls (ownable_id, owner_id) VALUES (NEW.ownable_id, NEW.owner_id); END
CREATE TRIGGER ownable_owners_update_trigger INSTEAD OF UPDATE ON ownable_owners FOR EACH ROW BEGIN UPDATE ownable_owners_rls SET ownable_id = NEW.ownable_id, owner_id = NEW.owner_id WHERE ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id; END
CREATE TRIGGER ownable_owners_delete_trigger INSTEAD OF DELETE ON ownable_owners FOR EACH ROW BEGIN DELETE FROM ownable_owners_rls WHERE ownable_id = OLD.ownable_id AND owner_id = OLD.owner_id; END
CREATE TRIGGER ownable_owners_rls_update_check BEFORE UPDATE ON ownable_owners_rls FOR EACH ROW WHEN NOT EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames) AND owner IN ('pg_key_action')) BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
CREATE TRIGGER ownable_owners_ownable_owners_ownable_id_fkey_pg2sqlite_key_delete AFTER DELETE ON ownables_rls FOR EACH ROW BEGIN INSERT INTO pg2sqlite_definer_frames (owner) VALUES ('pg_key_action'); DELETE FROM ownable_owners_rls WHERE ownable_id = OLD.id; DELETE FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames); END
