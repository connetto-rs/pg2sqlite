CREATE TRIGGER groups_groups_id_fkey_pg2sqlite_key_body_child_insert AFTER INSERT ON groups FOR EACH ROW WHEN EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE owner = 'pg_body_statement') BEGIN INSERT INTO groups_groups_id_fkey_pg2sqlite_key_body_records (frame, side, key_0, identity_0) SELECT (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1), 0, NEW.id, NEW.id WHERE (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) IS NOT NULL AND (NEW.id IS NOT NULL) AND NOT EXISTS (SELECT 1 FROM groups_groups_id_fkey_pg2sqlite_key_body_records WHERE frame = (SELECT CASE WHEN owner = 'pg_body_statement' THEN id END FROM pg2sqlite_definer_frames WHERE owner IN ('pg_body_statement', 'pg_body_statement_skipped') ORDER BY id DESC LIMIT 1) AND side = 0 AND key_0 IS NOT DISTINCT FROM NEW.id AND identity_0 IS NOT DISTINCT FROM NEW.id); END
