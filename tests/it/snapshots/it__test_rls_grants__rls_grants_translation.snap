CREATE TRIGGER ownable_administrators_rls_update_check BEFORE UPDATE ON ownable_administrators_rls FOR EACH ROW WHEN NOT EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames WHERE owner NOT IN ('pg_body_statement', 'pg_body_statement_skipped')) AND owner IN ('pg_key_action', 'pg_truncate')) BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
