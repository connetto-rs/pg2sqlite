CREATE VIEW ownables_unfiltered AS SELECT id AS id, title AS title, created_by AS created_by FROM ownables_rls
CREATE VIEW ownable_owners_unfiltered AS SELECT ownable_id AS ownable_id, owner_id AS owner_id FROM ownable_owners_rls
CREATE VIEW ownable_administrators_unfiltered AS SELECT ownable_id AS ownable_id, administrator_id AS administrator_id, granted_by AS granted_by FROM ownable_administrators_rls
CREATE VIEW grants AS SELECT id, ownable_id, grantee_id, grantor_id, role_id FROM grants_rls WHERE (grantor_id = current_app_user() OR grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = grants_rls.grantee_id) OR EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = grants_rls.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = grants_rls.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))))
CREATE TRIGGER grants_insert_trigger INSTEAD OF INSERT ON grants FOR EACH ROW BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy') WHERE ((NEW.grantor_id = current_app_user() AND (EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = NEW.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id)))))) IS NOT TRUE; INSERT INTO grants_rls (id, ownable_id, grantee_id, grantor_id, role_id) VALUES (COALESCE(NEW.id, uuidv7()), NEW.ownable_id, NEW.grantee_id, NEW.grantor_id, NEW.role_id); END
CREATE TRIGGER grants_rls_insert_check BEFORE INSERT ON grants_rls FOR EACH ROW WHEN ((NEW.grantor_id = current_app_user() AND (EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = NEW.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id)))))) IS NOT TRUE BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
