CREATE TRIGGER grants_rls_update_check BEFORE UPDATE ON grants_rls FOR EACH ROW WHEN (((OLD.grantor_id = current_app_user())) IS NOT TRUE OR ((NEW.grantor_id = current_app_user())) IS NOT TRUE OR ((NEW.grantor_id = current_app_user() OR NEW.grantee_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = NEW.grantee_id) OR EXISTS (SELECT 1 FROM ownable_owners_unfiltered oo WHERE oo.ownable_id = NEW.ownable_id AND (oo.owner_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oo.owner_id))) OR EXISTS (SELECT 1 FROM ownable_administrators_unfiltered oa WHERE oa.ownable_id = NEW.ownable_id AND (oa.administrator_id = current_app_user() OR EXISTS (SELECT 1 FROM group_memberships gm WHERE gm.user_id = current_app_user() AND gm.group_id = oa.administrator_id))))) IS NOT TRUE) AND NOT EXISTS (SELECT 1 FROM pg2sqlite_definer_frames WHERE id = (SELECT max(id) FROM pg2sqlite_definer_frames) AND owner IN ('pg_key_action')) BEGIN SELECT RAISE(ABORT, 'new row violates row-level security policy'); END
